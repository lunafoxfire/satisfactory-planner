{
	"name": "satisfactory-planner",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "oxlint",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"import-game-data": "tsx tools/import-game-data.ts"
	},
	"imports": {
		"#api/*": "./src/api/*.ts",
		"#components/*": "./src/components/*.tsx",
		"#data/*": "./src/data/*.ts",
		"#hooks/*": "./src/hooks/*.ts",
		"#lib/*": "./src/lib/*.ts",
		"#providers/*": "./src/providers/*.tsx"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@phosphor-icons/react": "^2.1.10",
		"@tailwindcss/vite": "^4.3.3",
		"class-variance-authority": "^0.7.1",
		"cmdk": "^1.1.1",
		"cn": "^0.2.5",
		"cytoscape": "^3.34.3",
		"highs": "^1.15.2",
		"lucide-react": "^1.41.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"shadcn": "^4.21.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.5.4",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.54.4",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.1.0",
		"oxlint": "^1.79.0",
		"tsx": "^4.23.13",
		"typescript": "~6.0.2",
		"vite": "^8.2.2",
		"wrangler": "^4.129.0",
		"yaml": "^2.9.0"
	}
}
